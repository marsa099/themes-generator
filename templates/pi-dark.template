		"slate": "{{semantic.type}}",
		"lavender": "{{semantic.boolean}}",
		"rose": "{{semantic.number}}",
		"stone": "{{semantic.operator}}",
		"text": "{{foreground.primary}}",
		"textSecondary": "{{foreground.secondary}}",
		"muted": "{{foreground.muted}}",
		"dim": "{{foreground.subtle}}",
		"bgPrompt": "{{background.prompt}}",
		"bgSelection": "{{background.selection}}",
